# HINWEIS: Die Website laeuft unter Express (server.js). Diese Datei wird dort
# NICHT ausgewertet. Sperren und Weiterleitungen stehen in server.js.

Options -MultiViews

# Schutz: interne Entwickler-Dateien nicht oeffentlich ausliefern (403)
# Frontend-Dateien (main.js, chart.umd.js, .css, Bilder, sitemap.xml, robots.txt) bleiben erreichbar.
<FilesMatch "\.(md|json|mjs|env|example|gitignore|gitattributes)$">
    Require all denied
</FilesMatch>
<Files "server.js">
    Require all denied
</Files>

# 301 Redirects – alte Rechner-URLs
Redirect 301 /solarisator /unabhaengigkeit
Redirect 301 /energierechner /nutzen
Redirect 301 /waermepumpe-rechner /heizkosten
# Versicherungsseite entfernt (25.09.2026) - kein Vermarkten von
# Versicherungsleistungen mehr ueber die Website.
RedirectMatch 301 ^/analyse-vorsorge(\.html)?/?$ /

RewriteEngine On
RewriteBase /

# 1. Existierende Dateien direkt ausliefern (.html, .css, .js, Bilder etc.)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 2. Existierende Verzeichnisse direkt ausliefern (Index-Dateien)
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Clean URL → .html (z.B. /impressum → impressum.html)
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# 4. Alles andere → index.html (SPA Fallback)
RewriteRule ^ index.html [L]
